{
  "info": {
    "name": "OS Service — Oficina Mecânica",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Coleção completa do OS Service — Fase 4 FIAP"
  },
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:8080"},
    {"key": "token", "value": ""},
    {"key": "clienteId", "value": ""},
    {"key": "veiculoId", "value": ""},
    {"key": "osId", "value": ""},
    {"key": "osNumero", "value": ""}
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login Admin",
          "event": [{"listen": "test", "script": {"exec": ["var r = pm.response.json();", "pm.collectionVariables.set('token', r.token);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {"mode": "raw", "raw": "{\n  \"login\": \"admin\",\n  \"senha\": \"admin123\"\n}"}
          }
        }
      ]
    },
    {
      "name": "Clientes",
      "item": [
        {
          "name": "Cadastrar Cliente",
          "event": [{"listen": "test", "script": {"exec": ["var r = pm.response.json();", "pm.collectionVariables.set('clienteId', r.id);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/clientes",
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"João Silva\",\n  \"email\": \"joao@email.com\",\n  \"telefone\": \"11999999999\",\n  \"cpf\": \"123.456.789-00\"\n}"}
          }
        },
        {
          "name": "Listar Clientes",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/clientes"
          }
        },
        {
          "name": "Buscar Cliente por ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/clientes/{{clienteId}}"
          }
        }
      ]
    },
    {
      "name": "Veículos",
      "item": [
        {
          "name": "Cadastrar Veículo",
          "event": [{"listen": "test", "script": {"exec": ["var r = pm.response.json();", "pm.collectionVariables.set('veiculoId', r.id);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/veiculos",
            "body": {"mode": "raw", "raw": "{\n  \"marca\": \"Toyota\",\n  \"modelo\": \"Corolla\",\n  \"ano\": 2020,\n  \"cor\": \"Prata\",\n  \"placa\": \"ABC1234\",\n  \"clienteId\": \"{{clienteId}}\"\n}"}
          }
        },
        {
          "name": "Listar Veículos",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/veiculos"
          }
        }
      ]
    },
    {
      "name": "Ordens de Serviço",
      "item": [
        {
          "name": "Abrir OS",
          "event": [{"listen": "test", "script": {"exec": ["var r = pm.response.json();", "pm.collectionVariables.set('osId', r.id);", "pm.collectionVariables.set('osNumero', r.numero);"]}}],
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/ordens",
            "body": {"mode": "raw", "raw": "{\n  \"clienteId\": \"{{clienteId}}\",\n  \"veiculoId\": \"{{veiculoId}}\"\n}"}
          }
        },
        {
          "name": "Listar OSs",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/ordens"
          }
        },
        {
          "name": "Buscar OS por ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/ordens/{{osId}}"
          }
        },
        {
          "name": "Iniciar Diagnóstico",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/ordens/{{osId}}/iniciar-diagnostico"
          }
        },
        {
          "name": "Enviar Orçamento (→ AGUARDANDO_APROVACAO)",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/ordens/{{osId}}/enviar-orcamento"
          }
        },
        {
          "name": "Cancelar OS",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/ordens/{{osId}}/cancelar"
          }
        }
      ]
    },
    {
      "name": "Endpoints Públicos (Cliente)",
      "item": [
        {
          "name": "Status Público da OS",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/public/ordens/{{osNumero}}/status"
          }
        },
        {
          "name": "Aprovar Orçamento",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/public/ordens/{{osNumero}}/aprovar"
          }
        },
        {
          "name": "Recusar Orçamento",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/public/ordens/{{osNumero}}/recusar"
          }
        }
      ]
    },
    {
      "name": "Catálogo de Serviços",
      "item": [
        {
          "name": "Criar Serviço",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/servicos",
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Troca de óleo\",\n  \"descricao\": \"Troca de óleo e filtro\",\n  \"precoBase\": 150.00\n}"}
          }
        },
        {
          "name": "Listar Serviços",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/servicos"
          }
        }
      ]
    },
    {
      "name": "Relatórios",
      "item": [
        {
          "name": "Tempo Médio de Execução",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": "{{baseUrl}}/api/admin/relatorios/tempo-medio"
          }
        }
      ]
    }
  ]
}
